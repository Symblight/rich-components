{
  "name": "@symblight/code-editor",
  "version": "0.1.0",
  "description": "A Material Design 3 code editor web component built on CodeMirror 6 and Lit",
  "author": "Aleksei Tkachenko <leshtkachenko@gmail.com>",
  "license": "MIT",
  "keywords": [
    "material-design",
    "material-design-3",
    "md3",
    "editor",
    "code-editor",
    "codemirror",
    "web-components",
    "custom-elements",
    "lit",
    "lit-element"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./presets": {
      "import": "./dist/presets/index.js",
      "types": "./dist/presets/index.d.ts"
    },
    "./lsp": {
      "import": "./dist/lsp/index.js",
      "types": "./dist/lsp/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sb": "storybook dev -p 6009",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "prettier --write . --ignore-path .gitignore",
    "prepare": "vite build",
    "prepublishOnly": "npm run build",
    "test": "web-test-runner --config web-test-runner.config.js"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "lit": ">=3.0.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@symblight/wc-material": "^0.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@open-wc/testing": "4.0.0",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/web-components": "^10.3.1",
    "@storybook/web-components-vite": "^10.3.1",
    "@symblight/md-colors": "^0.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^10.8.0",
    "lit": "^3.3.2",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-postcss-lit": "^2.2.0",
    "storybook": "^10.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "@codemirror/lsp-client": {
      "optional": true
    }
  }
}
