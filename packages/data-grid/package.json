{
  "name": "@symblight/data-grid",
  "version": "0.1.0",
  "description": "A virtualized Material Design 3 data grid web component built with Lit",
  "author": "Aleksei Tkachenko <leshtkachenko@gmail.com>",
  "license": "MIT",
  "keywords": [
    "material-design",
    "material-design-3",
    "md3",
    "data-grid",
    "web-components",
    "custom-elements",
    "lit",
    "lit-element"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-theme": "md-colors --output=./theme.css",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "prettier --write . --ignore-path .gitignore",
    "prepublishOnly": "npm run build",
    "test": "web-test-runner --config web-test-runner.config.js"
  },
  "peerDependencies": {
    "lit": ">=3.0.0"
  },
  "dependencies": {
    "@lit-labs/observers": "^2.1.0",
    "@lit/context": "^1.1.6",
    "@symblight/wc-material": "^0.0.22",
    "@tanstack/lit-virtual": "^3.13.36"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@material-design-icons/svg": "^0.14.15",
    "@open-wc/testing": "4.0.0",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/web-components": "^10.3.1",
    "@storybook/web-components-vite": "^10.3.1",
    "@symblight/md-colors": "^0.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^10.8.0",
    "lit": "^3.3.2",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-postcss-lit": "^2.2.0",
    "storybook": "^10.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
